# Dependencies
node_modules/
**/node_modules/

# Environment variables — contains JWT_SECRET, DB credentials, etc.
# Never commit this; each environment (your machine, a teammate's,
# production) should have its own local .env file.
.env
.env.local
.env.*.local

# Uploaded resource files (PDFs/ZIPs students upload) — these are user
# data, not source code, and can get large fast. Keep the folder
# structure tracked but not its contents.
uploads/*
!uploads/.gitkeep
server/uploads/*
!server/uploads/.gitkeep

# Build output
dist/
build/
**/dist/
**/build/

# Vite
.vite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Misc
*.local